# =============================================
# recover-filenames 設定
# =============================================

# 対象ディレクトリ（--target-dir のデフォルト値）
# RECOVER_TARGET_DIR=F:\anime\2025年-夏

# 対象ファイル拡張子
RECOVER_EXTENSION=.ts

# RecName_Macro.so 互換のマクロパターン
RECOVER_MACRO_PATTERN=$SDYYYY$-$SDMM$-$SDDD$_$STHH$-$STMM$_$ServiceName$-$EventName$

# 壊れたファイル名検出用カスタム正規表現（未指定時は ~ を含むファイルを対象）
# RECOVER_FILENAME_PATTERN=

# Windows 禁止文字のエスケープ文字
RECOVER_ESCAPE_WITH=_

# dry-run モード（true/false）
RECOVER_DRY_RUN=false

# メタデータファイルも付け替える（true/false）
RECOVER_KEEP_METADATA=true

# 壊れたファイル名と判定する最大ファイル名長さ（拡張子除く）
# デフォルトは10文字。これより長いファイル名は「壊れていない」として無視される
# 0または負の値、あるいは none / unlimited で無制限
RECOVER_MAX_FILENAME_LENGTH=10

# =============================================
# rename-with-macro 設定
# =============================================

# 対象ディレクトリ
# RENAME_TARGET_DIR=F:\anime\2025年-夏

# RecName_Macro.so 互換のマクロパターン（必須）
# RENAME_MACRO_PATTERN=$SDYYYY$-$SDMM$-$SDDD$_$STHH$-$STMM$_$ZtoH(ServiceName)$-$ZtoH(Title)$.ts

# Windows 禁止文字のエスケープ文字
RENAME_ESCAPE_WITH=_

# dry-run モード（true/false）
RENAME_DRY_RUN=false

# メタデータファイルも付け替える（true/false）
RENAME_KEEP_METADATA=true

# 壊れたファイル名と判定する最大ファイル名長さ（拡張子除く）
# デフォルトは10文字。壊れたファイル名はリネーム対象外
# 0または負の値、あるいは none / unlimited で無制限
RENAME_MAX_FILENAME_LENGTH=10

# =============================================
# prune-duplicates 設定
# =============================================

# 対象ディレクトリ
# PRUNE_DUPLICATES_TARGET_DIR=F:\anime\test

# move または delete
PRUNE_DUPLICATES_ACTION=move

# 移動先ディレクトリ
# move 時のみ使用。未指定なら対象ディレクトリ配下の _duplicates
# PRUNE_DUPLICATES_DEST_DIR=F:\anime\duplicates

# dry-run モード（true/false）
PRUNE_DUPLICATES_DRY_RUN=false

# 重複候補とみなすシリーズ名類似度
PRUNE_DUPLICATES_MIN_SIMILARITY=0.78

# 同一番組候補とみなす放送日の最大差
PRUNE_DUPLICATES_MAX_DAYS_APART=14
